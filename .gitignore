.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pytype/
.ruff_cache/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db

# Editor and IDE settings
.vscode/
.idea/

# Local environment variables and secrets
.env
.env.*
!.env.example

